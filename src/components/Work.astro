---
import type { Copy } from "../data/copy.ts";
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<section id="work">
  <p class="kicker"><span>{copy.work.kicker}</span></p>
  <h2 class="s-title">{copy.work.title}</h2>
  <ol class="jobs" reversed>
    {copy.work.jobs.map((j) => {
      const caseHref = copy.work.caseSlugs[j.company];
      return (
        <li class="job">
          <div class="period">
            <span class="bullet" aria-hidden="true"></span>
            <span>{j.period}</span>
          </div>
          <div>
            <div class="job-row">
              <span class="company">{j.company}</span>
              <span class="role">{j.role}</span>
              <span class="industry">{j.industry}</span>
            </div>
            <p class="summary">{j.summary}</p>
            <ul class="tags" aria-label="stack">
              {j.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
            {caseHref && (
              <a class="job-case" href={caseHref}>
                <span aria-hidden="true">›</span> {copy.work.caseLabel}
              </a>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</section>
