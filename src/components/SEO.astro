---
import type { Lang } from "../data/copy.ts";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // e.g. "/" or "/en/"
}

const { lang, title, description, path } = Astro.props;

const SITE = "https://marcarcherciscar.com";
const canonical = new URL(path, SITE).toString();
const ogImage = new URL("/og.png", SITE).toString();

const altPath = lang === "es" ? "/en/" : "/";
const altLang = lang === "es" ? "en" : "es";
const altUrl = new URL(altPath, SITE).toString();

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Marc Archer Ciscar",
  givenName: "Marc",
  familyName: "Archer Ciscar",
  jobTitle: lang === "es" ? "Tech Lead · Full Stack Engineer" : "Tech Lead · Full Stack Engineer",
  worksFor: { "@type": "Organization", name: "Farmavázquez" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Valencia",
    addressCountry: "ES",
  },
  url: SITE,
  image: ogImage,
  sameAs: [
    "https://www.linkedin.com/in/marc-archer-ciscar/",
    "https://github.com/MarcArcherCiscar",
  ],
  knowsAbout: [
    "Astro", "Svelte", "Vue.js", "TypeScript", "Rust", "Node.js",
    "PostgreSQL", "MongoDB", "Flutter", "E-commerce", "SaaS",
  ],
  email: "mailto:marcarcher1999@gmail.com",
};

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Marc Archer Ciscar",
  url: SITE,
  inLanguage: lang === "es" ? "es-ES" : "en-US",
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Marc Archer Ciscar" />
<meta name="theme-color" content="#0a0c0a" />
<meta name="color-scheme" content="dark" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={lang === "es" ? "es-ES" : "en-US"} href={canonical} />
<link rel="alternate" hreflang={altLang === "es" ? "es-ES" : "en-US"} href={altUrl} />
<link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="mask-icon" href="/favicon-mask.svg" color="#6dff8e" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Open Graph -->
<meta property="og:type" content="profile" />
<meta property="og:site_name" content="Marc Archer Ciscar" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={lang === "es" ? "Portfolio terminal brutalista de Marc Archer Ciscar" : "Marc Archer Ciscar brutalist terminal portfolio"} />
<meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
<meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
<meta property="profile:first_name" content="Marc" />
<meta property="profile:last_name" content="Archer Ciscar" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={lang === "es" ? "Portfolio terminal de Marc Archer" : "Marc Archer terminal portfolio"} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline></script>
<script type="application/ld+json" set:html={JSON.stringify(siteLd)} is:inline></script>
