---
import type { Copy } from "../data/copy.ts";
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<section id="stack">
  <p class="kicker"><span>{copy.stack.kicker}</span></p>
  <h2 class="s-title">{copy.stack.title}</h2>
  <p class="stack-note">{copy.stack.note}</p>

  <ol class="stack-choices">
    {copy.stack.choices.map((c) => (
      <li class="stack-choice">
        <p class="stack-when">{c.when}</p>
        <p class="stack-picks">{c.picks}</p>
        <p class="stack-why">{c.why}</p>
      </li>
    ))}
  </ol>

  <p class="stack-breadth-label">{copy.stack.breadthLabel}</p>
  <ul class="stack-breadth">
    {copy.stack.breadth.map((b) => <li>{b}</li>)}
  </ul>
</section>
