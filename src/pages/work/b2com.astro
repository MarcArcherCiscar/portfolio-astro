---
import Base from "../../layouts/Base.astro";
import TopBar from "../../components/TopBar.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { COPY } from "../../data/copy.ts";
import { CASES } from "../../data/cases.ts";

const lang = "es" as const;
const copy = COPY[lang];
const case_ = CASES[lang].b2com;
---
<Base lang={lang} title={case_.meta.title} description={case_.meta.description} path="/work/b2com/">
  <TopBar copy={copy} lang={lang} />
  <CaseStudy case_={case_} homeHref="/" />
  <SiteFooter copy={copy} />
</Base>
